{
  "manifest_version": 3,
  "name": "Auto Picture-in-Picture",
  "version": "1.1",
  "description": "動画の再生中に他のタブやアプリに切り替えると、自動でピクチャーインピクチャーに移行します。",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
